# std.sys: the command line, environment variables and files, with failures as values.
module std.sys

use std.list (List, Nil, Cons)
use std.option (Option, None, Some)
use std.result (Result, Ok, Err)

# The command-line arguments of the program, in order.
pub args :: -- (List String) ! Env
pub args = arg_count 1 sub Nil args_loop

# `i acc args_loop` puts the arguments i, i-1, ..., 0 in front of `acc`.
args_loop :: Int (List String) -- (List String) ! Env
args_loop = let i acc in i 0 lt
  | then acc
  | else i 1 sub i arg acc Cons args_loop

# `name var` is the value of the environment variable, if it is set.
pub var :: String -- (Option String) ! Env
pub var = env_var
  | then Some
  | else drop None

# `path read_file` is the contents of the file, or the error message.
pub read_file :: String -- (Result String String) ! Fs
pub read_file = file_read
  | then Ok
  | else Err

# `path text write_file` writes the file. The result is the path, or the error message.
pub write_file :: String String -- (Result String String) ! Fs
pub write_file = let path text in path text file_write
  | then drop path Ok
  | else Err
